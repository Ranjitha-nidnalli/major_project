# Krishi Mitra — Environment Configuration
# Copy this file to `.env` (in this directory) and fill in your actual
# values. `.env` is gitignored; never commit real API keys.

# ---------------------------------------------------------------------------
# LLM Backend
# ---------------------------------------------------------------------------

# Which LLM backend to use: "groq", "openrouter", or "ollama".
# Ollama path is untested on Windows+Python 3.13 due to a client-side bug.
LLM_BACKEND=groq

# Generation model ID. There is no hardcoded fallback in code — this must
# be set. NOTE: llama-3.1-8b-instant is DEPRECATED on Groq; use
# openai/gpt-oss-20b or another currently-active model. For OpenRouter, use
# the full model path (e.g. "meta-llama/llama-3.1-8b-instruct").
GENERATION_MODEL=openai/gpt-oss-20b

# Groq API key. Required if LLM_BACKEND=groq. Get one free at
# https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# OpenRouter API key. Required if LLM_BACKEND=openrouter. Used for
# cross-judge evaluation (a different provider judging Groq-generated
# answers) and for the Phase 5 model bake-off. Get one at
# https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Ollama host. Only used if LLM_BACKEND=ollama. Untested on this project's
# current Windows+Python 3.13 environment (see llm_client.py docstring).
OLLAMA_HOST=http://localhost:11434

# Model that judges faithfulness in backend/eval/run_eval.py (P2.3). Only
# required when running that script -- it raises ValueError if unset.
# Self-judging (same value as GENERATION_MODEL) is allowed as a documented,
# pragmatic tradeoff for free-tier rate limits, but must be an explicit
# choice; a different model here avoids the self-preference bias risk.
JUDGE_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Embeddings & Reranker
# ---------------------------------------------------------------------------

# Hugging Face model ID for the dense+sparse embedding model (BGE-M3).
EMBEDDING_MODEL=BAAI/bge-m3

# Hugging Face model ID for the cross-encoder reranker. Loaded at startup
# regardless of ENABLE_RERANKER below; only used in the request path when
# ENABLE_RERANKER=true.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Enable cross-encoder reranking in the live request path? "true" or
# "false". Default off: on a single-crop corpus, first-stage recall is
# near-ceiling and reranking adds ~30s latency on CPU with minimal
# MRR/nDCG gain (ARCHITECTURE.md Section 13).
ENABLE_RERANKER=false

# Opt-in, default OFF. Lowers the pest/disease abstention-gate relevance
# threshold from the safety-critical default (0.50) to the general
# default (0.35). Verified 2026-09-23: pure dense relevance cannot
# separate correct from incorrect pest/disease matches at ANY threshold
# -- a correct answer scored 0.489, a wrong-entity hallucination scored
# HIGHER at 0.597. The entity_match_hook (validated 9/9 for this same
# category pair) now catches the actual danger case; the stricter
# relevance floor mostly just blocks correct answers. Left off by
# default because this weakens a safety-critical refusal control in a
# domain where the standing rule is "refusing is always better than
# guessing" -- turning it on is a deliberate decision for you to make,
# not something to enable without reading TODO.md #46 first.
ENABLE_LENIENT_PEST_DISEASE_THRESHOLD=false

# ---------------------------------------------------------------------------
# Vector Store (Qdrant)
# ---------------------------------------------------------------------------

# URL of a running Qdrant server, e.g. http://localhost:6333. Bring one up
# with `docker compose up -d` (docker-compose.yml at the repo root). If this
# is unset, vector_db.py falls back to a local file-mode Qdrant store at
# backend/qdrant_sugarcane_db/, which only allows one process to hold it at
# a time — server mode is the target setup, file mode is a fallback only.
QDRANT_URL=http://localhost:6333

# ---------------------------------------------------------------------------
# Chat Memory (MongoDB)
# ---------------------------------------------------------------------------

# MongoDB connection string. Bring one up with `docker compose up -d`
# (same compose file as Qdrant above). No auth assumed for local dev.
MONGO_URI=mongodb://localhost:27017

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of origins the API will accept browser requests
# from. Defaults to the local Next.js dev server if unset.
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Generation Limits
# ---------------------------------------------------------------------------

# Max tokens to generate for an interactive chat request vs. an offline
# evaluation run (evaluation answers are allowed to run longer).
INTERACTIVE_MAX_PREDICT=250
EVAL_MAX_PREDICT=500

# Timeout in seconds for interactive generation before falling back to the
# timeout message.
INTERACTIVE_TIMEOUT=120
