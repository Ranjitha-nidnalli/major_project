# Krishi Mitra — Environment Configuration
# Copy this file to `.env` and fill in your actual values.

# ---------------------------------------------------------------------------
# LLM Backend
# ---------------------------------------------------------------------------
# Which LLM backend to use: "groq", "openrouter", or "ollama"
# Ollama path is untested on Windows+Python 3.13 due to a client-side bug.
LLM_BACKEND=groq

# Default model ID. 
# NOTE: llama-3.1-8b-instant is DEPRECATED on Groq. 
# Use openai/gpt-oss-20b or another active model.
# For OpenRouter, use the full model path (e.g., "meta-llama/llama-3.1-8b-instruct").
GENERATION_MODEL=openai/gpt-oss-20b

# Groq API key (required if LLM_BACKEND=groq)
# Get one free at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# OpenRouter API key (required if LLM_BACKEND=openrouter)
# Used for cross-judge evaluation (different provider judging Groq-generated answers).
# Get one at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Ollama host (only used if LLM_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Embeddings & Reranker
# ---------------------------------------------------------------------------
# Hugging Face model IDs for local embedding and reranking
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Enable cross-encoder reranking? "true" or "false"
# Default off: on a single-crop corpus, first-stage recall is near-ceiling
# and reranking adds ~30s latency on CPU with minimal MRR/nDCG gain.
ENABLE_RERANKER=false

# ---------------------------------------------------------------------------
# Vector Store
# ---------------------------------------------------------------------------
# Qdrant runs in local file-mode (no separate server)
# The database path is hardcoded in vector_db.py as ./qdrant_sugarcane_db

# ---------------------------------------------------------------------------
# Chat Memory
# ---------------------------------------------------------------------------
# MongoDB connection string (local, no auth needed for dev)
MONGO_URI=mongodb://localhost:27017

# ---------------------------------------------------------------------------
# Web Fallback (DEPRECATED — removed from pipeline)
# ---------------------------------------------------------------------------
# Tavily web search fallback was dead code (instantiated but never called).
# Removed in recent refactor. These vars are ignored.
ENABLE_WEB_FALLBACK=false
TAVILY_API_KEY=tvly-your_key_here

# ---------------------------------------------------------------------------
# Generation Limits
# ---------------------------------------------------------------------------
# Max tokens for interactive chat vs evaluation runs
INTERACTIVE_MAX_PREDICT=250
EVAL_MAX_PREDICT=500

# Timeout in seconds for interactive generation
INTERACTIVE_TIMEOUT=120
